# LLM Insight — example environment. PLACEHOLDERS ONLY.
# Copy to .env (git-ignored) and replace every CHANGE_ME value.
# Never put backend secrets in NEXT_PUBLIC_* variables.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=llminsight
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=llminsight
# Host port published on 127.0.0.1 (55432 avoids a native PostgreSQL on 5432). Keep in sync with the URL below.
POSTGRES_HOST_PORT=55432

# --- Backend ---
LLMI_DATABASE_URL=postgresql+psycopg://llminsight:CHANGE_ME@127.0.0.1:55432/llminsight
LLMI_BIND_HOST=127.0.0.1
LLMI_PORT=8000
# Random >= 32 bytes; used for HMAC of project ingest keys. Rotating invalidates all keys.
LLMI_KEY_PEPPER=CHANGE_ME
# Server-side admin/read token for /api/v1/* (also given to the Next.js server as LLMI_API_TOKEN).
LLMI_ADMIN_TOKEN=CHANGE_ME
LLMI_OTLP_MAX_BODY_BYTES=4194304
LLMI_OTLP_MAX_DECOMPRESSED_BYTES=16777216
LLMI_OTLP_MAX_SPANS_PER_REQUEST=2048
# Overall deadline (seconds, 0 < x <= 300) for receiving one /v1/traces body after auth; 408 if exceeded.
LLMI_OTLP_BODY_READ_TIMEOUT_S=10
LLMI_RATE_LIMIT_INGEST_RPS=20
LLMI_RATE_LIMIT_INGEST_BURST=40
LLMI_RATE_LIMIT_API_RPS=10
LLMI_RATE_LIMIT_API_BURST=20
LLMI_RATE_LIMIT_AUTHFAIL_PER_MIN=30
LLMI_RETENTION_DAYS=14
# Real LLM experiments are refused unless this is true (and a budget is given per run).
LLMI_ALLOW_REAL_LLM=false

# --- Instrumented demo app / SDK ---
OTEL_SERVICE_NAME=demo-summarizer
OTEL_TRACES_SAMPLER=always_on
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:8000/v1/traces
OTEL_EXPORTER_OTLP_TRACES_COMPRESSION=gzip
# Ingest key printed once by the backend init command.
OTEL_EXPORTER_OTLP_TRACES_HEADERS=X-Project-Key=CHANGE_ME
# Do NOT set OTEL_EXPORTER_OTLP_TRACES_TIMEOUT: the spec says milliseconds, but exporter 1.45.1
# reads seconds (verified in Phase 2A). The SDK ignores it and passes the value below explicitly.
# SDK settings (sdk/README.md). Units are in the names: exporter in SECONDS, processor in MILLIS.
LLMI_SDK_SERVICE_VERSION=0.1.0
LLMI_SDK_DEPLOYMENT_ENVIRONMENT=dev
LLMI_SDK_EXPORT_TIMEOUT_SECONDS=5
LLMI_SDK_SCHEDULE_DELAY_MILLIS=1000
LLMI_SDK_MAX_QUEUE_SIZE=2048
LLMI_SDK_MAX_EXPORT_BATCH_SIZE=512
LLMI_SDK_SHUTDOWN_TIMEOUT_MILLIS=5000
# synthetic is the only accepted value in Phase 2A (real is reserved for the provider adapter).
LLMI_SDK_PROVENANCE=synthetic
# mock (default, no spend) | real (requires OPENAI_API_KEY and explicit approval)
LLMI_PROVIDER_MODE=mock
# Never paste a key here or into chat/docs; set it in your own shell only when approved.
OPENAI_API_KEY=
# Session spending ceiling of the live runner (USD, Decimal, > 0 and <= 5.00).
LLMI_REAL_LLM_BUDGET_USD=

# --- Live provider execution (Phase 6A; python -m demo_app.live_openai) ---
# OFF unless EVERY value below is set and valid: an API key alone never enables a call.
# Empty means "not configured" and refuses execution. Example values: docs/PHASE6_LIVE_INTEGRATION_PLAN.md §G.
# Exact consent phrase: openai-paid-calls
LLMI_LIVE_CONSENT=
# Provider allowlist (only: openai) and model allowlist (verified-price models only).
LLMI_LIVE_PROVIDERS=
LLMI_LIVE_MODELS=
# Positive limits (hard caps in sdk/src/llm_insight_sdk/live.py).
LLMI_LIVE_MAX_REQUESTS=
LLMI_LIVE_MAX_INPUT_TOKENS=
LLMI_LIVE_MAX_OUTPUT_TOKENS=
LLMI_LIVE_MAX_REQUEST_COST_USD=
# Optional; empty uses the safe default: 20 s timeout, 0 retries, 1 request in flight.
LLMI_LIVE_TIMEOUT_SECONDS=
LLMI_LIVE_MAX_RETRIES=
LLMI_LIVE_MAX_CONCURRENCY=

# --- Gemini Free Tier (Phase 6C-A; python -m demo_app.live_gemini) ---
# Uses LLMI_PROVIDER_MODE=real and the LLMI_LIVE_* settings above with Gemini values:
# consent phrase gemini-free-tier-single-call, provider gcp.gemini, model gemini-3.1-flash-lite,
# 1 request, output 16..1024 tokens, input <= 1024, timeout <= 30 s, 0 retries, concurrency 1
# (LLMI_LIVE_MAX_REQUEST_COST_USD is not used: a Free Tier call has no cost to reserve).
# Exactly: free-tier (there is no paid mode)
LLMI_GEMINI_MODE=
# Operator attestation, NOT a proof from Google billing: the project's AI Studio "Billing Tier"
# (only: free) and the UTC date (YYYY-MM-DD) you checked it, at most one day old.
LLMI_GEMINI_BILLING_TIER=
LLMI_GEMINI_TIER_CHECKED_ON=
# Never paste a key here or into chat/docs; set it in your own shell only when approved.
# Leave GOOGLE_API_KEY, GOOGLE_GENAI_USE_VERTEXAI, GOOGLE_CLOUD_PROJECT, GOOGLE_GEMINI_BASE_URL
# and the other google-genai routing variables UNSET: the runner refuses them (ADR-34).
GEMINI_API_KEY=

# --- Groq Free Plan (Phase 8A-3, ADR-44): NOT USABLE YET ---
# No runner exists and real Groq requests are locked in code; no Free Plan evidence is released.
# When released, uses LLMI_PROVIDER_MODE=real and the LLMI_LIVE_* settings above with Groq values:
# consent phrase groq-free-plan-single-call, provider groq, exactly one verified model,
# 1 request, output 16..1024 tokens, input <= 1024, 0 retries, concurrency 1 (timeout fixed at 30 s).
# Exactly: free-plan (there is no paid mode)
LLMI_GROQ_MODE=
# Operator attestation, NOT a proof from Groq billing: the account's plan (only: free) and the
# UTC date (YYYY-MM-DD) you checked it, at most one day old.
LLMI_GROQ_PLAN=
LLMI_GROQ_PLAN_CHECKED_ON=
# Never paste a key here or into chat/docs; set it in your own shell only when approved.
# Leave GROQ_BASE_URL, the *_PROXY variables, SSL_CERT_FILE, SSL_CERT_DIR and SSLKEYLOGFILE UNSET.
GROQ_API_KEY=

# --- Frontend (Next.js SERVER-side only; no NEXT_PUBLIC_ prefix) ---
# The dashboard reads these from frontend/.env.local (git-ignored), created with
# `python -I scripts/dev/init_frontend_env.py --project-id <id>`; listed here for reference.
# Loopback origin only (the dashboard refuses any other host, so the token never leaves the machine).
LLMI_API_BASE_URL=http://127.0.0.1:8000
LLMI_API_TOKEN=CHANGE_ME
# Default project of the dashboard (pages accept ?project=<id>; the selector lists projects, Phase 3C).
# Also used by the compose `app` profile (docker-compose.yml).
LLMI_DASHBOARD_PROJECT_ID=1
# Per-request deadline for backend reads, 100-30000 ms.
LLMI_API_TIMEOUT_MS=5000
