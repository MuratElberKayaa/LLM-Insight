{
  "name": "llm-insight-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "LLM Insight local dashboard (Next.js App Router). Server-side backend access only.",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1 --port 3001",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "zod": "4.6.6",
    "typescript-eslint": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/scope-manager": "8.71.1",
    "@typescript-eslint/types": "8.71.1",
    "@typescript-eslint/tsconfig-utils": "8.71.1",
    "@typescript-eslint/visitor-keys": "8.71.1",
    "@typescript-eslint/project-service": "8.71.1",
    "@typescript-eslint/typescript-estree": "8.71.1",
    "@typescript-eslint/utils": "8.71.1",
    "@typescript-eslint/type-utils": "8.71.1",
    "browserslist": "4.29.3",
    "caniuse-lite": "1.0.30001815",
    "node-releases": "2.0.58",
    "electron-to-chromium": "1.5.452",
    "baseline-browser-mapping": "2.11.28",
    "napi-postinstall": "0.3.4",
    "immer": "11.1.21",
    "@babel/parser": "7.29.9",
    "@babel/types": "7.29.8",
    "@babel/helper-string-parser": "7.29.7",
    "ignore": "7.0.12",
    "es-toolkit": "1.52.0",
    "@tailwindcss/postcss": {
      "postcss": "8.5.29"
    }
  }
}
